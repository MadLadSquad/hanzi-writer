{
  "name": "hanzi-writer",
  "version": "3.0.0",
  "author": "David Chanin <chanindav@gmail.com> (http://chanind.github.io/hanzi-writer/)",
  "description": "Hanzi Writer is a free and open-source javascript library for both animating simplified Chinese characters and quizzing users on character stroke order.",
  "repository": "chanind/hanzi-writer",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.esm.d.ts",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@sinonjs/fake-timers": "^15.4.0",
    "@types/jest": "^30.0.0",
    "@types/nise": "^1.4.5",
    "@types/node": "^26.4.1",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "codecov": "^3.8.3",
    "eslint": "^10.9.1",
    "hanzi-writer-data": "^2.0.1",
    "jest": "^30.5.1",
    "jest-canvas-mock": "^2.5.8",
    "jest-cli": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-fetch-mock": "^4.2.0",
    "nise": "^6.1.5",
    "prettier": "^3.9.6",
    "rollup": "^4.63.1",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-license": "^3.7.1",
    "rollup-plugin-ts": "^3.4.5",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "scripts": {
    "test": "jest",
    "lint-test": "eslint src",
    "lint-fix": "eslint --fix src",
    "build": "rm -rf dist && rollup -c",
    "prepublishOnly": "rollup -c",
    "semantic-release": "semantic-release",
    "prettier": "prettier -w src",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "files": [
    "dist"
  ],
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "setupFiles": [
      "jest-canvas-mock"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest-setup.js"
    ],
    "coverageDirectory": "<rootDir>/coverage/",
    "testEnvironmentOptions": {
      "url": "https://test.com/url#tag"
    },
    "collectCoverage": true,
    "testEnvironment": "<rootDir>/jest-jsdom-env"
  },
  "dependencies": {}
}
